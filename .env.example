# Copy to .env and adjust paths/settings as needed.

# OCR architecture:
# - single_vl: use PaddleOCR-VL 1.6 for every receipt. Recommended first version.
# - multi_model: use CLIP ViT-B/32 zero-shot routing, then PP-OCR for printed receipts and VL for hard receipts.
RECEIPT_OCR_MODE=single_vl

# CLIP router settings used only when RECEIPT_OCR_MODE=multi_model.
RECEIPT_ENABLE_CLIP_ROUTER=true
RECEIPT_CLIP_MODEL_NAME=openai/clip-vit-base-patch32
RECEIPT_CLIP_MIN_CONFIDENCE=0.34

# Unsloth Qwen3.5-2B UD Q4_K_XL GGUF for structured extraction.
RECEIPT_QWEN_MODEL_PATH=models/unsloth-qwen3.5-2b-ud-q4_k_xl.gguf

RECEIPT_MAX_IMAGE_LONG_EDGE=2200
RECEIPT_ENABLE_PADDLEOCR=true
RECEIPT_ENABLE_LLM=true

# PaddleOCR-VL 1.6. Required for single_vl mode and recommended as fallback in multi_model mode.
RECEIPT_ENABLE_VL=true
RECEIPT_PADDLE_VL_PIPELINE_VERSION=v1.6
RECEIPT_PADDLE_VL_DEVICE=cpu
RECEIPT_PADDLE_VL_ENGINE=
RECEIPT_PADDLE_VL_USE_LAYOUT_DETECTION=true
RECEIPT_PADDLE_VL_USE_DOC_ORIENTATION_CLASSIFY=false
RECEIPT_PADDLE_VL_USE_DOC_UNWARPING=false
RECEIPT_PADDLE_VL_MAX_CONCURRENCY=1
RECEIPT_PADDLE_VL_FOR_UNKNOWN_ROUTE=true

# Optional: use a local PaddleOCR-VL llama.cpp server instead of direct VLM inference.
# Start llama-server separately, then set these:
# RECEIPT_PADDLE_VL_REC_BACKEND=llama-cpp-server
# RECEIPT_PADDLE_VL_REC_SERVER_URL=http://localhost:8111/v1
# RECEIPT_PADDLE_VL_REC_API_MODEL_NAME=PaddleOCR-VL-1.6
# RECEIPT_PADDLE_VL_REC_API_KEY=

RECEIPT_LLM_CONTEXT_SIZE=4096
RECEIPT_LLM_GPU_LAYERS=-1
RECEIPT_LLM_TEMPERATURE=0.1
RECEIPT_REVIEW_CONFIDENCE_THRESHOLD=0.78
